# Ventrix Server Environment Variables
PORT=5000

# Database Configuration:
# For cloud databases (Neon, Supabase, Render, Railway, Vercel Postgres):
# Simply provide DATABASE_URL (SSL is automatically enabled):
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/ventrix?sslmode=require

# Or standard discrete parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ventrix
# DB_USER=postgres
# DB_PASSWORD=admin123
# DB_SSL=false

# Security & Tokens
JWT_SECRET=generate_a_secure_random_string_here
TELEMETRY_INGEST_KEY=generate_a_secure_ingest_key_here

# Allowed CORS Origins (comma-separated, or use * for wildcard)
# All *.vercel.app domains are automatically allowed by default
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
